;;;; AU3 levels: RMS, PEAK, FRAME-RMS, NORMALIZE and DOWNMIX, on vectors and
;;;; on PCM-BUFFERs.

(in-package #:audio-protocol/tests)

(deftest rms-and-peak-of-vectors
  (ok (approx= (sqrt 12.5d0) (dsp:rms #(3 -4)) 1d-15))
  (ok (eql 4d0 (dsp:peak #(3 -4 1/2))) "PEAK is the largest magnitude, a DOUBLE-FLOAT")
  (ok (eql 0d0 (dsp:rms #())) "no samples: 0")
  (ok (eql 0d0 (dsp:peak #())))
  (ok (eql 0d0 (dsp:rms (make-array 5 :initial-element 0))))
  (let ((x (sine-vector 16000 16000 1000 :amplitude 0.5d0)))
    (ok (typep (dsp:rms x) 'double-float))
    (ok (approx= (/ 0.5d0 (sqrt 2d0)) (dsp:rms x) 1d-6) "a sine over whole periods: A / sqrt 2")
    (ok (approx= 0.5d0 (dsp:peak x) 1d-6)))
  (ok (approx= 0.5d0 (dsp:rms (dvector 0.5 -0.5 0.5 -0.5)) 1d-15))
  (ok (signals (dsp:rms '(1 2)) 'type-error))
  (ok (signals (dsp:peak "ab") 'type-error)))

(deftest rms-and-peak-of-buffers
  (let ((b (buffer 8000 2 0.5 -0.25 0.5 -0.25 0.5 -0.25)))
    (ok (approx= (sqrt (/ (+ 0.25d0 0.0625d0) 2)) (dsp:rms b) 1d-15) "every sample of every channel")
    (ok (eql 0.5d0 (dsp:peak b))))
  (ok (eql 0d0 (dsp:rms (make-pcm-buffer :channels 2))))
  (ok (eql 0d0 (dsp:peak (make-pcm-buffer :channels 2 :frames 10))))
  (ok (eql 1d0 (dsp:peak (buffer 44100 1 0.0 -1.0 0.5)))))

(deftest frame-rms-matches-the-frames
  (let* ((*seed* 11)
         (x (random-reals 5000)))
    (dolist (pad dsp:+pad-policies+)
      (let ((got (dsp:frame-rms x 512 128 :pad pad))
            (frames (dsp:frame-signal x 512 128 :pad pad)))
        (ok (typep got +double-vector+))
        (ok (= (length frames) (length got)) (format nil "~(~S~): one value a frame" pad))
        (ok (loop for f across frames for r across got always (approx= (rms f) r 1d-9))
            (format nil "~(~S~): the RMS of each frame, padding included" pad))))
    (ok (within (dsp:frame-rms x 512 128) (dsp:frame-rms x 512 128 :pad :center) 0)
        "PAD defaults to :CENTER")))

(deftest frame-rms-of-silence-is-zero
  ;; A loud passage, then silence: frames wholly in the silence are exactly 0,
  ;; which a running sum of squares over the whole signal doesn't give.
  (let* ((x (make-array 40000 :element-type 'double-float :initial-element 0d0)))
    (dotimes (i 20000)
      (setf (aref x i) (* 0.9d0 (sin (/ (* 2 (dpi) 440 i) 16000)))))
    (let ((got (dsp:frame-rms x 1024 256 :pad :none)))
      (ok (every (lambda (r) (>= r 0)) got) "never negative")
      (ok (loop for i from (ceiling 20000 256) below (length got)
                always (<= (aref got i) (* 1d-9 0.9d0)))
          "frames after the passage: 0 within 1e-9 * peak")
      (ok (approx= (/ 0.9d0 (sqrt 2d0)) (aref got 10) 5d-3) "a frame of the passage"))))

(deftest frame-rms-of-buffers
  (let ((b (make-pcm-buffer :sample-rate 8000 :samples (sine-vector 800 8000 500))))
    (ok (within (dsp:frame-rms b 64 32) (dsp:frame-rms (pcm-channel b 0) 64 32) 0)
        "a mono buffer stands for its samples"))
  (ok (signals (dsp:frame-rms (make-pcm-buffer :channels 2 :frames 100) 64 32) 'audio-error))
  (ok (signals (dsp:frame-rms (sine-vector 100 8000 500) 64 0) 'type-error)))

(deftest normalize-vectors
  (let* ((x (vector 0.1d0 -0.4d0 0.2d0))
         (copy (copy-seq x))
         (y (dsp:normalize x)))
    (ok (typep y +double-vector+) "a fresh DOUBLE-VECTOR")
    (ok (within y #(0.25d0 -1d0 0.5d0) 1d-15) "peak to 0 dBFS")
    (ok (equalp x copy) "the input isn't modified"))
  (let* ((g (db-to-gain -6))
         (y (dsp:normalize #(1 -2 4) :peak-db -6)))
    (ok (approx= g (dsp:peak y) 1d-15) "peak to -6 dBFS")
    (ok (within y (map 'vector (lambda (v) (* v (/ g 4))) #(1 -2 4)) 1d-15)))
  (let ((y (dsp:normalize (make-array 2 :element-type 'single-float
                                        :initial-contents '(0.5 0.25))
                          :peak-db 6)))
    (ok (typep y +double-vector+))
    (ok (approx= (db-to-gain 6) (aref y 0) 1d-15) "above 0 dBFS: nothing is clipped"))
  (let ((y (dsp:normalize (vector 0 0 0))))
    (ok (typep y +double-vector+))
    (ok (equalp #(0d0 0d0 0d0) y) "silence is copied, unscaled"))
  (ok (equalp #() (dsp:normalize #())))
  (ok (signals (dsp:normalize '(1 2)) 'type-error))
  (ok (signals (dsp:normalize #(1 2) :peak-db "0") 'type-error)))

(deftest normalize-buffers
  (let* ((b (buffer 8000 2 0.25 -0.125 0.0625 0.1))
         (copy (make-pcm-buffer :sample-rate 8000 :channels 2 :samples (pcm-buffer-samples b)))
         (y (dsp:normalize b)))
    (ok (pcm-buffer-p y) "a buffer gives a buffer")
    (ok (and (= 8000 (pcm-buffer-sample-rate y)) (= 2 (pcm-buffer-channels y))
             (= 2 (pcm-buffer-frames y))))
    (ok (equalp '(1.0 -0.5 0.25 0.4) (samples y)) "peak 0.25 to 1: every sample times 4")
    (ok (equalp b copy) "the input isn't modified")
    (ok (not (eq (pcm-buffer-samples b) (pcm-buffer-samples y)))))
  (let* ((b (buffer 16000 1 0.3 -0.6 0.15))
         (g (/ (db-to-gain -3) (float 0.6f0 1d0)))
         (y (dsp:normalize b :peak-db -3)))
    (ok (every-approx= (samples y)
                       (mapcar (lambda (x) (single (* (float x 1d0) g))) (samples b))
                       1d-7)
        "each sample times g, rounded once")
    (ok (approx= (db-to-gain -3) (dsp:peak y) 1d-7)))
  (let ((y (dsp:normalize (buffer 8000 1 0.5 -0.25) :peak-db 6)))
    (ok (approx= (db-to-gain 6) (dsp:peak y) 1d-6) "no clipping above 0 dBFS"))
  (let* ((silence (make-pcm-buffer :sample-rate 8000 :channels 2 :frames 3))
         (y (dsp:normalize silence)))
    (ok (equalp silence y) "silence: an EQUALP copy")
    (ok (not (eq silence y)))))

(deftest downmix-means-the-channels
  (let* ((b (buffer 8000 3 0.3 0.6 0.9 -1 0 1))
         (m (dsp:downmix b)))
    (ok (pcm-buffer-p m))
    (ok (and (= 1 (pcm-buffer-channels m)) (= 8000 (pcm-buffer-sample-rate m))
             (= 2 (pcm-buffer-frames m))))
    (ok (equalp (list (single (/ (+ (float 0.3f0 1d0) (float 0.6f0 1d0) (float 0.9f0 1d0)) 3))
                      0.0)
                (samples m))
        "the mean in DOUBLE-FLOAT, rounded once"))
  (let* ((mono (buffer 22050 1 0.1 0.2 0.3))
         (copy (dsp:downmix mono)))
    (ok (equalp mono copy) "a mono buffer gives a copy")
    (ok (not (eq (pcm-buffer-samples mono) (pcm-buffer-samples copy)))))
  (let* ((*seed* 12)
         (stereo (make-pcm-buffer :sample-rate 44100 :channels 2
                                  :samples (random-reals 2000))))
    (ok (equalp (mix (list stereo) :channels 1 :clip :none) (dsp:downmix stereo))
        "stereo: exactly MIX to one channel"))
  (ok (equalp (dsp:downmix (make-pcm-buffer :channels 4)) (make-pcm-buffer :channels 1))
      "no frames")
  (ok (signals (dsp:downmix #(1 2)) 'type-error)))
